# ==========================================
# EchoSign Environment Configuration
# ==========================================
# DO NOT commit the actual .env file to git
# Only commit .env.example with placeholder values

# ── SERVER CONFIGURATION ──────────────────
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── FRONTEND ENVIRONMENT (Vite) ───────────
VITE_API_BASE_URL=http://localhost:5001
VITE_INFERENCE_URL=http://localhost:8000

# ── AUTHENTICATION ────────────────────────
# Generate a strong JWT secret for production
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_here_minimum_32_characters

# ── DATABASE CONFIGURATION ────────────────
# MongoDB (optional, uses in-memory store if not configured)
MONGO_URI=mongodb://localhost:27017/echosign

# PostgreSQL (optional, uses in-memory store if not configured)
POSTGRES_URI=postgresql://user:password@localhost:5432/echosign

# ── EXTERNAL AI MODELS ────────────────────
# Google Generative AI (Gemini)
# Get your key: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── INFERENCE SERVICE ─────────────────────
# Python FastAPI microservice for MediaPipe sign detection
INFERENCE_SERVICE_URL=http://localhost:8000

# ── RATE LIMITING ─────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── LOGGING ───────────────────────────────
LOG_LEVEL=info
